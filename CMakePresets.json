{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows x64 native WebView2",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "IR_BUILD_DESKTOP": "ON",
        "BUILD_TESTING": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-windows-release",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets"
      },
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}
    },
    {
      "name": "headless",
      "displayName": "Native API without a graphical shell",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/headless",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "IR_BUILD_DESKTOP": "OFF", "BUILD_TESTING": "ON"}
    }
  ],
  "buildPresets": [
    {"name": "windows", "configurePreset": "windows", "configuration": "Release", "jobs": 2},
    {"name": "headless", "configurePreset": "headless", "jobs": 2}
  ],
  "testPresets": [
    {"name": "windows", "configurePreset": "windows", "configuration": "Release", "output": {"outputOnFailure": true}},
    {"name": "headless", "configurePreset": "headless", "output": {"outputOnFailure": true}}
  ]
}
