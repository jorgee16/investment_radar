{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Instalar / compilar",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/install.sh"
      ],
      "windows": {
        "command": "cmd.exe",
        "args": [
          "/d",
          "/c",
          "install.bat"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Executar",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/run.sh"
      ],
      "windows": {
        "command": "cmd.exe",
        "args": [
          "/d",
          "/c",
          "run.bat"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
